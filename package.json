{
  "name": "@digital-india-project/dip-analytics",
  "version": "0.1.0",
  "description": "Secure, tenant-aware analytics domain, event contracts, deterministic aggregations, and reporting foundation for Digital India Project.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/event-schemas.d.ts",
      "default": "./dist/schemas/event-schemas.js"
    },
    "./privacy": {
      "types": "./dist/privacy/index.d.ts",
      "default": "./dist/privacy/index.js"
    },
    "./validation": {
      "types": "./dist/validation/event-validator.d.ts",
      "default": "./dist/validation/event-validator.js"
    },
    "./aggregations": {
      "types": "./dist/aggregations/index.d.ts",
      "default": "./dist/aggregations/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./reporting": {
      "types": "./dist/reporting/index.d.ts",
      "default": "./dist/reporting/index.js"
    },
    "./dashboards": {
      "types": "./dist/dashboards/index.d.ts",
      "default": "./dist/dashboards/index.js"
    },
    "./reliability": {
      "types": "./dist/reliability/index.d.ts",
      "default": "./dist/reliability/index.js"
    },
    "./telemetry": {
      "types": "./dist/telemetry/context.d.ts",
      "default": "./dist/telemetry/context.js"
    },
    "./ecosystem": {
      "types": "./dist/ecosystem/index.d.ts",
      "default": "./dist/ecosystem/index.js"
    }
  },
  "scripts": {
    "dev": "npm run build && node dist/runtime/contract-server.js",
    "start": "node dist/runtime/contract-server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests && tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/tests/**/*.test.js\"",
    "benchmark": "npm run build && node dist/runtime/benchmark.js",
    "clean": "rm -rf dist .test-dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
